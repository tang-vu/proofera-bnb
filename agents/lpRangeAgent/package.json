{
  "name": "proofera-lp-range-agent-workspace",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "audit:prod": "pnpm --dir app/agent audit:prod",
    "build": "pnpm --dir app/agent build",
    "dev": "pnpm --dir app/agent dev",
    "format": "pnpm --dir app/agent exec prettier --write ../../AGENTS.md ../../README.md ../../package.json ../../pnpm-workspace.yaml .",
    "format:check": "pnpm --dir app/agent exec prettier --check ../../AGENTS.md ../../README.md ../../package.json ../../pnpm-workspace.yaml .",
    "lint": "pnpm --dir app/agent lint",
    "test": "pnpm --dir app/agent test",
    "typecheck": "pnpm --dir app/agent typecheck",
    "start": "pnpm --dir app/agent start",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
