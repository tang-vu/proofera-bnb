{
  "name": "yieldOptimisationAgent-agent",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "description": "ProofEra deterministic, evidence-aware yield route analyzer.",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/dualMain.ts",
    "start": "node dist/src/dualMain.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@bnbagent/studio-runtime": "0.0.8",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
