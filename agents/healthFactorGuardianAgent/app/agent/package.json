{
  "name": "@proofera/health-factor-guardian-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "description": "Strict deterministic read-only Venus Core Pool health-factor analyzer over A2A and MCP.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "dev": "tsx src/dualMain.ts",
    "start": "node dist/src/dualMain.js",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@bnbagent/studio-runtime": "0.0.8",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
