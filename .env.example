# Public canonical origin. Use the final HTTPS judging hostname before creating
# durable passkeys; the WebAuthn relying-party ID is domain-bound.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional WebAuthn RP ID. Leave empty locally so the browser uses localhost.
# Production value must be the hostname only, with no scheme or path.
NEXT_PUBLIC_ALTANA_RP_ID=

# Immutable, non-secret build identifier (release tag or commit SHA). Production
# readiness fails closed when it is absent or malformed.
PROOFERA_BUILD_VERSION=

# Server-only 8004scan key. Anonymous reads work at a much lower rate limit.
# Never prefix this with NEXT_PUBLIC_.
PROOFERA_8004SCAN_API_KEY=

# Strict means upstream failures become explicit unavailable/stale states.
# There is deliberately no automatic fixture fallback in a live runtime.
PROOFERA_DATA_MODE=strict

# Optional server-side RPC override. The default is a documented public BSC
# endpoint; production should use a rate-limited key stored only on the server.
# Pancake's public inspector uses an unsplit latest Multicall3 snapshot and then
# verifies that exact block's identity; it never downgrades to unrelated latest
# calls or requires historical contract-state reads.
BSC_RPC_URL=
BSC_TESTNET_RPC_URL=
