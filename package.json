{
  "name": "proofera-bnb",
  "version": "0.1.0",
  "private": true,
  "description": "Hire autonomous DeFi agents by proof, not promises.",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @proofera/web build",
    "capture:pancake:public-position": "node ./scripts/capture-pancake-public-position-benefit.mjs",
    "capture:production:release": "node ./scripts/capture-production-release-evidence.mjs --capture-exact-production-release --source-base-commit",
    "capture:demo:rehearsal": "node ./scripts/capture-public-demo-rehearsal.mjs --capture-exact-public-demo-rehearsal --source-base-commit",
    "capture:demo:video": "node ./scripts/capture-public-demo-video.mjs --capture-exact-public-demo-video --source-base-commit",
    "capture:altana:lifecycle": "node ./scripts/capture-altana-lifecycle-evidence.mjs --capture-exact-altana-lifecycle --source-base-commit",
    "capture:erc8004:registration": "node ./scripts/capture-erc8004-registration-evidence.mjs --capture-exact-four-agent-registration --source-base-commit",
    "capture:termix:hires": "node ./scripts/capture-termix-hire-evidence.mjs --capture-finalized --source-commit",
    "capture:termix:pancake-lp-order": "node ./scripts/capture-termix-pancake-lp-run-order.mjs",
    "capture:termix:venus-order": "node ./scripts/capture-termix-venus-health-run-order.mjs",
    "collect:termix:venus": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/typescript-extension-loader.mjs ./scripts/collect-termix-venus-exact-block.ts",
    "compile:termix:final": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/termix-typescript-loader.mjs ./scripts/compile-termix-final-evidence.ts --compile-exact-termix-final-evidence --source-base-commit",
    "freeze:termix:pancake-lp": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/termix-typescript-loader.mjs ./scripts/freeze-termix-pancake-lp-declaration.ts",
    "freeze:termix:venus": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/termix-typescript-loader.mjs ./scripts/freeze-termix-venus-health-declaration.ts",
    "run:termix:pancake-lp-agent": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/termix-typescript-loader.mjs ./scripts/run-termix-pancake-lp-agent.ts",
    "run:termix:pancake-lp-manual": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/termix-typescript-loader.mjs ./scripts/run-termix-pancake-lp-manual.ts",
    "run:termix:permission-audit-agent": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/termix-typescript-loader.mjs ./scripts/run-termix-permission-audit-agent.ts",
    "run:termix:permission-audit-manual": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/termix-typescript-loader.mjs ./scripts/run-termix-permission-audit-manual.ts",
    "run:termix:venus-agent": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/termix-typescript-loader.mjs ./scripts/run-termix-venus-health-agent.ts",
    "run:termix:venus-manual": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/termix-typescript-loader.mjs ./scripts/run-termix-venus-health-manual.ts",
    "dev": "pnpm --filter @proofera/web dev",
    "provision:altana:test-action": "node ./scripts/altana-test-action-worker.mjs --provision",
    "worker:altana:test-action": "node ./scripts/altana-test-action-worker.mjs --run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "security:secrets": "pnpm security:secrets:test && node scripts/check-secret-boundaries.mjs",
    "security:secrets:test": "node --test scripts/*.test.mjs",
    "submission:check": "node scripts/check-submission-readiness.mjs",
    "submission:require-ready": "node scripts/check-submission-readiness.mjs --require-ready",
    "deploy:pta:testnet": "node --no-warnings --conditions=react-server --experimental-loader ./scripts/typescript-extension-loader.mjs ./scripts/run-bsc-testnet-pta-deployment.ts --execute-exact-pta-chain-97",
    "initialize:pta-wbnb:testnet": "node -e \"process.stderr.write('Blocked: use the audited phase-minus-one command in docs/deployment.md.');process.exit(1)\"",
    "start": "pnpm --filter @proofera/web start",
    "test": "pnpm --recursive --if-present run test && pnpm test:evidence",
    "test:evidence": "node --test scripts/altana-lifecycle-evidence-lib.test.mjs scripts/bsc-testnet-pta-deployment-evidence.test.mjs scripts/bsc-testnet-pta-wbnb-pool-readiness-evidence.test.mjs scripts/bsc-testnet-pta-wbnb-pool-readiness-rpc-transcript.test.mjs scripts/capture-altana-bsc-testnet-readiness.test.mjs scripts/capture-altana-lifecycle-evidence.test.mjs scripts/capture-erc8004-registration-evidence.test.mjs scripts/capture-pancake-public-position-benefit.test.mjs scripts/capture-production-release-evidence.test.mjs scripts/capture-public-demo-rehearsal.test.mjs scripts/capture-public-demo-video.test.mjs scripts/capture-termix-pancake-lp-run-order.test.mjs scripts/erc8004-registration-evidence-lib.test.mjs scripts/freeze-termix-pancake-lp-declaration.test.mjs scripts/generate-termix-lp-preregistration-v2.test.mjs scripts/pancake-initializer-publication/publication.test.mjs scripts/pancake-initializer-review/review.test.mjs scripts/pancake-pool-external-review-request/review-request.test.mjs scripts/pancake-pool-init-code-review/review.test.mjs scripts/pancake-pool-owner-designated-review/review.test.mjs scripts/pancake-selector-review/review.test.mjs scripts/prepare-agent-registration-manifest.test.mjs scripts/submission-readiness.test.mjs scripts/termix-final-evidence-compiler.test.mjs scripts/termix-hire-evidence-lib.test.mjs scripts/termix-pancake-lp-agent-runner.test.mjs scripts/termix-pancake-lp-manual-runner.test.mjs scripts/termix-permission-audit-agent-runner.test.mjs scripts/termix-permission-audit-manual-runner.test.mjs scripts/termix-release-state.test.mjs scripts/termix-venus-development-evidence.test.mjs scripts/termix-venus-live-window-evidence.test.mjs scripts/termix-venus-health-agent-runner.test.mjs scripts/termix-venus-health-manual-runner.test.mjs scripts/wbnb-source-verification/evidence.test.mjs",
    "test:e2e": "pnpm --filter @proofera/web test:e2e",
    "typecheck": "pnpm --recursive --if-present run typecheck && tsc -p scripts/tsconfig.pta-deployment.json && tsc -p scripts/tsconfig.pta-wbnb-pool-initialization.json && tsc -p scripts/tsconfig.termix-final-evidence.json && tsc -p scripts/tsconfig.termix-pancake-lp-runner.json && tsc -p scripts/tsconfig.termix-permission-audit-runner.json && tsc -p scripts/tsconfig.termix-venus-collector.json && tsc -p scripts/tsconfig.termix-venus-freezer.json && tsc -p scripts/tsconfig.termix-venus-health-runner.json",
    "verify": "pnpm format:check && pnpm lint && pnpm security:secrets && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
